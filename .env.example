# Токен бота, полученный от @BotFather. ОБЯЗАТЕЛЬНО.
BOT_TOKEN=

# Строка подключения к БД.
# При запуске без Docker по умолчанию используется fin_faculty_bot.db в корне проекта.
# Docker Compose сам задаёт /app/data/fin_faculty_bot.db в постоянном volume.
# DATABASE_URL=sqlite+aiosqlite:////полный/путь/к/fin_faculty_bot.db
# Пример для PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fin_faculty_bot

# ID рабочей группы, куда будут приходить обращения студентов. ОБЯЗАТЕЛЬНО.
# Узнать ID группы можно, например, добавив в неё бота @getmyid_bot,
# либо посмотрев ID через API после добавления вашего бота в группу.
# Для супергрупп ID обычно отрицательный и начинается с -100.
WORK_GROUP_ID=

# ID темы (message_thread_id) в рабочей супергруппе.
# Если оставить пустым, обращения будут приходить в общую тему.
WORK_GROUP_THREAD_ID=

# Telegram user ID суперадминистратора (можно несколько через запятую).
# Только суперадмин может добавлять и удалять обычных администраторов.
# Узнать свой ID можно у бота @userinfobot.
SUPERADMIN_ID=

# Необязательные Telegram ID обычных администраторов для начальной загрузки.
# Если SUPERADMIN_ID не указан, этот параметр считается списком
# суперадминов для совместимости со старыми установками.
INITIAL_ADMIN_ID=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
